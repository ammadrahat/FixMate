# FixMate Home Services Marketplace - Supabase Environment Configuration
# Obtain these from your Supabase Dashboard: Project Settings -> API Keys

EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key

# Optional: Fix for Linux Electron sandbox error with React Native DevTools
ELECTRON_DISABLE_SANDBOX=1
